# ============================================
# Sensitive / Secret files — NEVER upload
# ============================================
.env
.env.local
*.env
secrets.yaml
secrets.json

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ============================================
# Virtual environments
# ============================================
venv/
env/
ENV/
.venv/
# conda env is stored outside project (D:\miniconda3\envs\emotion), no need to ignore

# ============================================
# Logs & runtime data
# ============================================
# Runtime/debug logs: excluded (large, not useful for collaboration)
logs/
*.log

# ============================================
# Structured session data (emotion records)
# ============================================
# Keep data/ directory structure in git, but exclude actual session files
# (they can be large; use git-lfs or keep locally)
data/sessions/*.json
data/sessions/*.csv
# Allow the directory itself to be tracked
!data/sessions/.gitkeep

# ============================================
# Model weights & large binary files
# ============================================
models/
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.bin
*.safetensors

# ============================================
# OS & IDE
# ============================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ============================================
# Jupyter
# ============================================
.ipynb_checkpoints/
*.ipynb

# ============================================
# Test artifacts
# ============================================
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ============================================
# Project memory (local only, contains tokens)
# ============================================
PROJECT_MEMORY.md

# ============================================
# Local scratch / planning files
# ============================================
*.txt
